rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;

      match /pregnancyLogs/{logId} {
        allow read, write: if true;
      }

      match /journalEntries/{entryId} {
        allow read, write: if true;
      }

      match /appointments/{appointmentId} {
        allow read, write: if true;
      }

      match /cachedContacts/{contactId} {
        allow read, write: if true;
      }
    }
  }
}
